# Server-side API base URL (never exposed to the browser).
API_URL=http://localhost:8400

# Browser API base URL. Public endpoints only; admin calls use same-origin proxy routes.
NEXT_PUBLIC_API_URL=http://localhost:8400

# Canonical application origin (used for absolute links and cookie security).
NEXT_PUBLIC_APP_URL=http://localhost:4300

# Optional game-host override. Normally taken from player_url returned by the API.
# If a local default is needed it is http://127.0.0.1:8401 (docs/12 and docs/13).
# NEXT_PUBLIC_GAME_HOST=http://127.0.0.1:8401

# Dev only: comma-separated hostnames (no scheme/port) allowed to load Next dev assets
# and HMR from another device. Empty means localhost-only. Example: 10.10.10.246
NEXT_ALLOWED_DEV_ORIGINS=

# Header title.
NEXT_PUBLIC_SITE_NAME=GamePortal

# HttpOnly cookie that holds the Sanctum admin token on the app origin.
AUTH_COOKIE_NAME=gp_admin_token
